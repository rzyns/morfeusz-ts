{
  "name": "@rzyns/morfeusz-ts",
  "version": "0.2.0",
  "description": "TypeScript bindings for Morfeusz 2 - Polish morphological analyzer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc",
    "clean": "rm -rf build dist",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "test": "npm run build:native && vitest run",
    "setup-dicts": "node scripts/setup.ts",
    "postinstall": "node scripts/postinstall.ts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:preview": "conventional-changelog -p angular -r 1",
    "prepare": "husky"
  },
  "keywords": [
    "morfeusz",
    "morfeusz2",
    "polish",
    "nlp",
    "morphology",
    "analyzer",
    "typescript",
    "bindings"
  ],
  "author": "morfeusz-ts contributors",
  "license": "BSD-2-Clause",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/types": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.6",
    "@semantic-release/npm": "^11.0.0",
    "@types/bindings": "^1.5.5",
    "@types/node": "^20.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.0",
    "jiti": "^2.6.1",
    "node-gyp": "^10.0.0",
    "semantic-release": "^23.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "gypfile": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
